{
  "_comment": "Baseline user-level settings.json planted by 21-claude-code.sh. If ~/.claude/settings.json already exists, the installer leaves it alone and writes this to settings.json.sre-helpers.example instead. Tweak keys here at will.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(systemctl status:*)",
      "Bash(journalctl:*)",
      "Bash(nginx -t)",
      "Bash(apachectl configtest)",
      "Bash(httpd -t)",
      "Bash(php -v)",
      "Bash(php --ini)",
      "Bash(composer --version)",
      "Bash(node -v)",
      "Bash(npm -v)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(shutdown*)",
      "Bash(reboot)",
      "Bash(mysqladmin drop*)",
      "Bash(DROP DATABASE*)"
    ]
  }
}
